{
	"private": true,
	"name": "personal-webpage",
	"author": "eccs0103",
	"version": "2.3.1",
	"type": "module",
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
		"dev": "vite",
		"build": "vite build",
		"preview": "npm run build && vite preview",
		"deploy": "vite build && wrangler deploy",
		"walk": "tsx feed/controllers/activity-controller.ts",
		"authorize:spotify": "tsx feed/controllers/spotify-authorization-controller.ts",
		"authorize:soundcloud": "tsx feed/controllers/soundcloud-authorization-controller.ts",
		"deploy:telegram-proxy": "wrangler deploy --config environment/workers/telegram-proxy/wrangler.jsonc"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.5",
		"@cloudflare/workers-types": "^5.20261003.1",
		"@types/node": "^24.19.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@mtcute/node": "^0.29.7",
		"@mtcute/web": "^0.29.7",
		"adaptive-extender": "^1.1.0",
		"dotenv": "^17.4.2"
	}
}
