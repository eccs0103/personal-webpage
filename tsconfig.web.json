{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": [ "DOM", "DOM.Iterable", "ES2025", "ESNext.Array" ],
		"jsx": "react-jsx"
	},
	"include": [
		"environment/controllers/**/*.ts",
		"environment/services/**/*.ts",
		"feed/controllers/metadata-controller.ts",
		"feed/controllers/webpage-controller.tsx",
		"feed/services/activity-collector.ts",
		"feed/services/activity-registry.ts",
		"feed/services/changelog-service.ts",
		"feed/services/client-bridge.ts",
		"feed/services/feed-loader.ts",
		"feed/services/github-summary-expert.ts",
		"feed/services/legacy-cell.ts",
		"feed/services/settings-service.ts",
		"feed/services/visit-service.ts",
		"feed/view/activity-feed.tsx",
		"feed/view/changelog-dialog.tsx",
		"feed/view/connections-hub.tsx",
		"feed/view/feed-app.tsx",
		"feed/view/platform-menu.tsx",
		"feed/view/render-strategies.tsx",
		"feed/view/spotlight.ts",
		"feed/view/translation-guard.ts",
		"feed/view/view-builders.tsx",
		"feed/view/welcome-dialog.tsx"
	],
	"exclude": [
		"environment/services/local-environment.ts",
		"environment/services/mime-registry.ts"
	]
}
